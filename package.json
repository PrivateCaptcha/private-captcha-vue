{
  "name": "private-captcha-vue-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace private-captcha-vue-demo --",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run --config packages/private-captcha-vue/vite.config.ts",
    "test:watch": "vitest --config packages/private-captcha-vue/vite.config.ts",
    "test:coverage": "vitest run --coverage --config packages/private-captcha-vue/vite.config.ts",
    "pack:check": "npm run pack:check --workspace @private-captcha/private-captcha-vue",
    "validate": "npm run lint && npm run typecheck && npm test && npm run build && npm run pack:check",
    "preview": "npm run preview --workspace private-captcha-vue-demo --"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@vue/server-renderer": "3.3.0",
    "@vue/test-utils": "2.5.0",
    "eslint": "^9.35.0",
    "eslint-plugin-vue": "^10.4.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.5",
    "vitest": "^5.0.1",
    "vue": "3.3.0",
    "vue-tsc": "^3.0.6"
  }
}
